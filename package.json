{
  "name": "@barissozudogru/test-gap-mcp",
  "version": "0.3.0",
  "description": "MCP server that identifies untested code and suggests test cases",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "test-gap-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "testing",
    "coverage",
    "typescript",
    "developer-tools",
    "test-gap",
    "test-coverage"
  ],
  "author": "barissozudogru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barissozudogru/test-gap-mcp.git"
  },
  "homepage": "https://github.com/barissozudogru/test-gap-mcp#readme",
  "bugs": {
    "url": "https://github.com/barissozudogru/test-gap-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
