{
  "name": "@barissozudogru/test-intel-mcp",
  "version": "0.8.1",
  "mcpName": "io.github.barissozudogru/test-intel",
  "description": "Test coverage intelligence MCP server - coverage analysis, untested function detection, and complexity scoring",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "test-intel-mcp": "dist/index.js",
    "test-intel-report": "dist/report.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "files": [
    "dist/**/*",
    "assets/banner-test-intel.svg",
    "assets/demo.gif",
    "evidence/p-limit-7.3.1/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "testing",
    "coverage",
    "typescript",
    "developer-tools",
    "test-intel",
    "test-coverage"
  ],
  "author": "barissozudogru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barissozudogru/test-intel-mcp.git"
  },
  "homepage": "https://petri-labs.org/tools/test-intel-mcp/",
  "bugs": {
    "url": "https://github.com/barissozudogru/test-intel-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
